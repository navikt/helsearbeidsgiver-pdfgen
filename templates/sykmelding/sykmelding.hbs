<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html lang="NO">
<head>
    <title>Sykmelding</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="description" content="Sykmelding" />
    <meta name="subject" content="Sykmelding" />
    <meta name="author" content="Nav" />
    <meta name="keywords" content="sykmelding" />

    <bookmarks>
        <bookmark title="Sykmeldt" href="#sykmeldt"></bookmark>
        <bookmark title="Arbeidsgiver" href="#arbeidsgiver"></bookmark>
        <bookmark title="Perioder" href="#perioder"></bookmark>
        <bookmark title="Egenmeldingsdager" href="#egenmeldingsdager"></bookmark>
        <bookmark title="Oppfølging" href="#oppfølging"></bookmark>
        <bookmark title="Behandler" href="#behandler"></bookmark>
    </bookmarks>

    {{#block 'style'}}
    {{/block}}
</head>
<body>

<h1 id="title">Sykmelding</h1>

{{!-- bruker display: table da dette anbefales av openHTMLtoPDF for accesibility --}}
{{!-- Avoid using table elements for layout. Instead, if desiring a table based layout, use a div with display: table, display: table-row, etc. --}}
<div style="margin-top: 8px; display: table; width: 100%;">
    <div style="display: table-row;">
        <p style="display: table-cell; text-align: left;" class="metadata-text text-sm">
            Mottatt av Nav {{ iso_to_nor_datetime mottattAvNav}}
        </p>
        <p style="display: table-cell; text-align: right;" class="metadata-text text-sm">
            Sykmeldings-ID: {{sykmeldingId}}
        </p>
    </div>
</div>
{{> partials/sykmeldtOgArbeidsgiverInfo
    sykmeldtNavn=sykmeldt.navn
    sykmeldtFnr=sykmeldt.fnr
    arbeidsgiverNavn=arbeidsgiver.navn
    arbeidsgiverOrgnr=arbeidsgiver.orgnr
}}
<h2 id="perioder">Perioder i sykmeldingen</h2>
<div>
    <p class="text-thin mb-3 text-sm">Syketilfelle fra:
        {{#if sykefravaerFom}}
            {{iso_to_date sykefravaerFom}}
        {{else}}
            —
        {{/if}}
    </p>
</div>

    {{#each sykmeldingPerioder}}
    <div class="table width-100 period-row text-sm">
        <div class="row">
            <p class="cell period-type font-semibold">
                {{!-- Teoretisk skal bare en av disse true, om ikke aksepterer vi rar formattering --}}

                {{#if aktivitet.aktivitetIkkeMulig}}
                    100% sykmeldt
                {{/if}}
                {{#if aktivitet.gradertSykmelding}}
                    {{aktivitet.gradertSykmelding.sykmeldingsgrad}}% sykmeldt
                {{/if}}
                {{#if aktivitet.avventendeSykmelding}}
                    Avventende sykmelding
                {{/if}}
                {{#if aktivitet.antallBehandlingsdagerUke}}
                    Behandlingsdager
                {{/if}}
                {{#if aktivitet.harReisetilskudd}}
                    Reisetilskudd
                {{/if}}

            </p>
            <p style="display: table-cell;" class="period-dates">
                {{> partials/periodeMedAntallDager fom=fom tom=tom }}
            </p>
            <p style="display: table-cell;" class="text-thin">
                {{#if aktivitet.gradertSykmelding}}
                    {{#if aktivitet.gradertSykmelding.harReisetilskudd}}
                        Med reisetilskudd {{else}} Uten reisetilskudd
                    {{/if}}
                {{/if}}

                {{#if aktivitet.aktivitetIkkeMulig}}
                    {{#if aktivitet.aktivitetIkkeMulig.manglendeTilretteleggingPaaArbeidsplassen}}
                        Manglende tilrettelegging på arbeidsplassen
                    {{/if}}
                {{/if}}

                {{#if aktivitet.antallBehandlingsdagerUke}}
                    {{aktivitet.antallBehandlingsdagerUke}} behandlingsdager
                {{/if}}
            </p>
        </div>
    </div>
    {{/each}}

<h2 id="egenmeldingsdager">Egenmeldingsdager</h2>
{{#if egenmeldingsdager}}
{{#if egenmeldingsdager.length}}
<p class="text-thin section-subtitle" style="color: #555555">Oppgitt av ansatt selv ved bekreftelse av sykmelding.</p>
<div style="display: table; width: 100%;">
    {{#each egenmeldingsdager}}
    <div style="display: table-row;">
        <p style="display: table-cell;" class="text-regular">
            {{> partials/periodeMedAntallDager fom=fom tom=tom }}
        </p>
    </div>
    {{/each}}
</div>
{{/if}}
{{else}}
<p class="text-thin section-subtitle">Ingen egenmeldingsdager oppgitt.</p>
{{/if}}

<h2 id="oppfølging">Oppfølging</h2>

{{!-- Skal vises bare om ingen av de andre oppfølgings punktene ble vist--}}
{{#any oppfoelging.prognose oppfoelging.tiltakArbeidsplassen oppfoelging.meldingTilArbeidsgiver}} {{else}}
    {{#contains_field sykmeldingPerioder "aktivitet.aktivitetIkkeMulig.beskrivelse"}} {{else}}
        {{#contains_field sykmeldingPerioder "aktivitet.avventendeSykmelding"}} {{else}}
            <p class="text-thin section-subtitle">Ingen oppfølging oppgitt.</p>
        {{/contains_field}}
    {{/contains_field}}
{{/any}}


<div style="display: table; width: 100%;">
    {{#if oppfoelging.prognose}}
    <div style="display: table-row;">
        <div style="display: table-cell;" class="followup-item">
            <h3 class="text-bold">Prognose og hensyn etter sykefravær</h3>
            {{#if oppfoelging.prognose.erArbeidsfoerEtterEndtPeriode}}
            <p style="margin: 4px 0;">&#8226; Arbeidsfør etter endt periode</p>
            {{/if}}
            {{#if oppfoelging.prognose.beskrivHensynArbeidsplassen}}
            <p class="text-thin">{{oppfoelging.prognose.beskrivHensynArbeidsplassen}}</p>
            {{/if}}
        </div>
    </div>
    {{/if}}
    {{#if oppfoelging.tiltakArbeidsplassen}}
    <div style="display: table-row;">
        <div style="display: table-cell;" class="followup-item">
            <h3 class="text-bold">Tiltak som kan bedre ansattes arbeidsevne</h3>
            <p class="text-thin">{{oppfoelging.tiltakArbeidsplassen}}</p>
        </div>
    </div>
    {{/if}}
    {{#if oppfoelging.meldingTilArbeidsgiver}}
    <div style="display: table-row;">
        <div style="display: table-cell;" class="followup-item">
            <h3 class="text-bold">Melding fra behandler til arbeidsgiver</h3>
            <p class="text-thin">{{oppfoelging.meldingTilArbeidsgiver}}</p>
        </div>
    </div>
    {{/if}}
    {{!-- forventer at det alltid er bare en aktivitetIkkeMulig.beskrivelse, om ikke aksepterer vi rar formattering  --}}
    {{#each sykmeldingPerioder}}
        {{#if aktivitet.aktivitetIkkeMulig.beskrivelse}}
                <div style="display: table-row;">
                    <div style="display: table-cell;" class="followup-item">
                        <h3 class="text-bold">Forhold på arbeidsplassen vanskeliggjør arbeidsrelatert aktivitet</h3>
                        <p class="text-thin">{{aktivitet.aktivitetIkkeMulig.beskrivelse}}</p>
                    </div>
                </div>
            {{/if}}
    {{/each}}

    {{!-- forventer at det alltid er bare en aktivitet.avventendeSykmelding, om ikke aksepterer vi rar formattering  --}}
        {{#each sykmeldingPerioder}}
            {{#if aktivitet.avventendeSykmelding}}
                    <div style="display: table-row;">
                        <div style="display: table-cell;" class="followup-item">
                            <h3 class="text-bold">Innspill til arbeidsgiver om tilrettelegging</h3>
                            <p class="text-thin">{{aktivitet.avventendeSykmelding}}</p>
                        </div>
                    </div>
                {{/if}}
        {{/each}}
</div>

{{!-- TODO: er <hr /> bad practice? skal denne byttes --}}
<hr />
<div class="info-box-table">
    <div class="info-box-row">
        <div class="info-box-cell bg-light-blue rounded-md doctor-card" style="width: 45%;" id="behandler">
            <h3 class="liten-label">Sykmelding skrevet av</h3>
            <p class="text-bold doctor-card-item text-lg">
                {{> partials/valueOrDash v=behandler.navn}}
            </p>

            <h3 class="liten-label">Telefon</h3>
            <p class="doctor-card-item">
                {{> partials/valueOrDash v=behandler.tlf}}
            </p>

            <h3 class="liten-label">Kontakt med pasient</h3>
            <p class="text-regular">
                {{iso_to_nor_datetime kontaktMedPasient}}
            </p>
        </div>
     <div class="info-box-cell"></div>
    </div>
</div>


</body>
</html>
