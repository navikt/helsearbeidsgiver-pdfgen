<div class="info-box-table">
    <div class="info-box-row">
        <section class="info-box-cell box-patient rounded-md" id="sykmeldt">
            <h3 class="liten-label">Sykmeldingen gjelder</h3>
            <p class="text-bold identity-name text-xl mb-2">{{sykmeldtNavn}}</p>
            <h3 class="liten-label">Fødselsnummer</h3>
            <p class="text-regular">{{sykmeldtFnr}}</p>
        </section>

        <section class="info-box-cell box-employer bg-light-blue rounded-md" id="arbeidsgiver">
            <h3 class="liten-label">Arbeidsgiver</h3>
            <p class="text-bold identity-name text-xl mb-2">{{arbeidsgiverNavn}}</p>
            <h3 class="liten-label">Organisasjonsnummer</h3>
            <p class="text-regular">{{arbeidsgiverOrgnr}}</p>
        </section>
    </div>
</div>