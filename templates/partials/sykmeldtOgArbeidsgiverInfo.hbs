            <p class="liten-label">Sykmeldingen gjelder</p>
            <p class="navn-datafelt">{{sykmeldtNavn}}</p>
            <p class="liten-label">Fødselsnummer</p>
            <p>{{sykmeldtFnr}}</p>
        </div>

        <div class="info-box-cell box-bright" id="arbeidsgiver">
            <p class="liten-label">Arbeidsgiver</p>
            <p class="navn-datafelt">{{arbeidsgiverNavn}}</p>
            <p class="liten-label">Organisasjonsnummer</p>
            <p>{{arbeidsgiverOrgnr}}</p>
        </div>
    </div>
</div>