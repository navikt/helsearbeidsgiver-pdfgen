{{!-- Én rad under «Detaljer for perioden». hag-refusjon har allerede gruppert dagene og regnet ut beløpet per dag. --}}
{{#eq sykepengeStatus "IKKE_RETT_TIL_SYKEPENGER"}}
    <div class="row daggruppe ikke-rett">
        <p class="cell kol-antall">{{> partials/refusjon/antallDager antall=antallDager entall="dag" flertall="dager" }}</p>
        <p class="cell kol-beskrivelse">Ikke rett til sykepenger</p>
        <p class="cell kol-strek">-</p>
        <p class="cell kol-beloep">{{currency_no beloepUtbetaltTilArbeidsgiverPerDag true}} kr/dag</p>
    </div>
{{else}}
    <div class="row daggruppe">
        <p class="cell kol-antall">{{> partials/refusjon/antallDager antall=antallDager entall="dag" flertall="dager" }}</p>
        <p class="cell kol-beskrivelse">sykepenger (sykdomsgrad: {{sykdomsgrad}}%)</p>
        <p class="cell kol-strek">-</p>
        <p class="cell kol-beloep">{{currency_no beloepUtbetaltTilArbeidsgiverPerDag true}} kr/dag</p>
    </div>
{{/eq}}
