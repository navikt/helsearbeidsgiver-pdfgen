<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html lang="no">
<head>
    <title>Refusjon av sykepenger</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="description" content="Informasjon om refusjon av sykepenger" />
    <meta name="subject" content="Refusjon av sykepenger" />
    <meta name="author" content="Nav" />
    <meta name="keywords" content="sykepenger refusjon" />

    <bookmarks>
        <bookmark title="Oppgitt refusjonsbeløp pr mnd i inntektsmelding" href="#oppgitt-refusjon"></bookmark>
        <bookmark title="Detaljer for perioden" href="#detaljer"></bookmark>
        <bookmark title="Refusjon for perioden" href="#refusjon"></bookmark>
    </bookmarks>

    {{#block 'style'}}
    {{/block}}

    <style type="text/css">
        /* Unngår en tom ekstra side når innholdet akkurat fyller siden */
        body {
            margin-bottom: 0;
        }

        h1 {
            font-weight: 700;
        }

        h2 {
            border-top: none;
            font-size: 20px;
            font-weight: 600;
            padding-top: 0;
            margin-top: 32px;
            margin-bottom: 2px;
        }

        .metadata {
            color: #4a515e;
            font-size: 13px;
            margin-top: 4px;
        }

        .metadata-id {
            text-align: right;
        }

        .gjeldende-periode {
            background-color: #e6f0f7;
            border-radius: 8px;
            padding: 10px 16px;
            font-size: 16px;
        }

        .gjeldende-periode .periode-label {
            font-weight: 600;
        }

        .gjeldende-periode .periode-datoer {
            text-align: right;
            word-spacing: 8px;
        }

        .intro {
            font-size: 16px;
            margin-top: 20px;
        }

        .stort-beloep {
            font-size: 30px;
            font-weight: 700;
            line-height: 1.3;
        }

        .endring-dato {
            font-size: 18px;
            font-weight: 400;
        }

        .detaljer {
            font-size: 18px;
            width: auto;
        }

        .detaljer .cell {
            padding-right: 12px;
            white-space: nowrap;
        }

        .detaljer .kol-beloep {
            text-align: right;
            padding-right: 0;
        }

        .daggruppe.ikke-rett {
            color: #c30000;
        }

        .varsel {
            margin-top: 20px;
            border: 3px solid #c45100;
            border-radius: 8px;
            page-break-inside: avoid;
        }

        .varsel-tittel {
            background-color: #c45100;
            color: white;
            font-weight: 600;
            padding: 2px 12px 4px;
        }

        .varsel-ikon {
            width: 18px;
            height: 18px;
            margin-right: 8px;
            vertical-align: -3px;
        }

        .varsel-innhold {
            padding: 8px 12px 12px;
            font-size: 16px;
        }

        .varsel-liste {
            padding-left: 30px;
            margin: 0;
        }
    </style>
</head>
<body>
    <h1>Refusjon av sykepenger</h1>

    <div class="table width-100 metadata">
        <div class="row">
            <p class="cell">{{iso_to_nor_datetime arbeidstakervedtakFattetTidspunkt}}</p>
            <p class="cell metadata-id">Refusjons-ID: {{refusjonUtfallId}}</p>
        </div>
    </div>

    {{> partials/sykmeldtOgArbeidsgiverInfo
            labelForNavn="Ansatt"
            sykmeldtNavn=sykmeldtNavn
            sykmeldtFnr=fnr
            arbeidsgiverNavn=arbeidsgiverNavn
            arbeidsgiverOrgnr=orgnr
    }}

    <div class="table width-100 gjeldende-periode">
        <div class="row">
            <p class="cell periode-label">Gjeldende periode</p>
            <p class="cell periode-datoer">{{iso_to_date fom}} → {{iso_to_date tom}}</p>
        </div>
    </div>

    <p class="intro">
        Saken til den sykmeldte er behandlet. Dette er en informasjonsmelding som inneholder opplysninger om utbetaling
        av sykepenger. Dine rettigheter som arbeidsgiver er avledet fra den sykmeldtes rettigheter til sykepenger.
    </p>

    <h2 id="oppgitt-refusjon">Oppgitt refusjonsbeløp pr mnd i inntektsmelding</h2>
    {{#if refusjonskrav}}
        <p class="stort-beloep">{{currency_no refusjonskrav.beloepPerMaaned true}} kr</p>
        {{#each refusjonskrav.endringer}}
            <p class="stort-beloep">{{currency_no beloep true}} kr <span class="endring-dato">(Fom. {{iso_to_date startdato}})</span></p>
        {{/each}}
    {{else}}
        <p class="stort-beloep">- kr</p>
    {{/if}}

    <h2 id="detaljer">Detaljer for perioden</h2>
    <div class="table detaljer">
        {{#each daggrupper}}
            {{> partials/refusjon/daggruppe }}
        {{/each}}
    </div>

    <h2 id="refusjon">Refusjon for perioden</h2>
    <p class="stort-beloep">{{currency_no beloepUtbetaltTilArbeidsgiver true}} kr</p>

    {{#if utbetalingKanVaereLavereEnnForventet}}
        <div class="varsel">
            <h3 class="varsel-tittel"><img src="{{ image "warning.svg" }}" class="varsel-ikon" alt=""/>Mulige grunner til at beløp er annet enn forventet</h3>
            <div class="varsel-innhold">
                <p>
                    Dersom refusjonsbeløpet er lavere enn forventet, kan det skyldes ulike årsaker. Nav oppgir ikke den
                    konkrete årsaken til redusert refusjon. Vanlige grunner til at en arbeidsgivers refusjon reduseres
                    inkluderer, men er ikke begrenset til:
                </p>
                <ul class="varsel-liste">
                    <li>6G flere AG</li>
                    <li>Annen inntekt lagt til grunn pga. 25 % avvik</li>
                    <li>Saksbehandler har overstyrt refusjonskravet</li>
                    <li>etc...</li>
                </ul>
                <p>Den nærmere begrunnelsen for reduksjon av refusjon i din sak er gitt i vedtaket til den sykmeldte.</p>
            </div>
        </div>
    {{/if}}
</body>
</html>
