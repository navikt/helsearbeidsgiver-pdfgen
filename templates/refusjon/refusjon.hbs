<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html lang="no">
<head>
    <title>Informasjon om refusjon av sykepenger</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="description" content="Informasjon om refusjon av sykepenger" />
    <meta name="subject" content="Informasjon om refusjon av sykepenger" />
    <meta name="author" content="Nav" />
    <meta name="keywords" content="sykepenger refusjon" />

    <bookmarks>
        <bookmark title="Oversikt over utbetalt refusjon" href="#utbetaling"></bookmark>
    </bookmarks>

    {{#block 'style'}}
    {{/block}}

    <style type="text/css">
        /* Unngår en tom ekstra side når innholdet akkurat fyller siden */
        body {
            margin-bottom: 0;
        }

        .metadata {
            color: #4a515e;
            font-size: 13px;
            margin-top: 10px;
        }

        .metadata-id {
            text-align: right;
        }

        .intro {
            margin-bottom: 16px;
        }

        .periode {
            color: #4a515e;
        }

        /* Tabellen er bygd av div-er med display: table, som anbefalt av openHTMLtoPDF for tilgjengelighet */
        .refusjon-tabell {
            table-layout: fixed;
        }

        .kol-dagtype { width: 38%; vertical-align: top; }
        .kol-forespurt { width: 20%; vertical-align: top; text-align: right; }
        .kol-forventet { width: 16%; vertical-align: top; text-align: right; }
        .kol-utbetalt { width: 22%; vertical-align: top; text-align: right; }
        .kol-varsel { width: 4%; vertical-align: top; text-align: right; }

        .refusjon-header {
            font-size: 13px;
            font-weight: 600;
            padding: 0 14px 4px;
            margin-top: 6px;
        }

        .daggruppe {
            background-color: #e6f0f7;
            border-radius: 8px;
            padding: 5px 14px;
            margin-bottom: 4px;
            page-break-inside: avoid;
        }

        .daggruppe.ikke-rett {
            background-color: #ffeccc;
        }

        .undertekst {
            color: #4a515e;
            font-size: 12px;
        }

        .utbetalt {
            font-size: 16px;
            font-weight: 600;
            line-height: 1.2;
        }

        .varsel-ikon {
            width: 16px;
            height: 16px;
            vertical-align: -3px;
        }

        .refusjon-sum {
            border-top: 1px solid #7f8287;
            margin-top: 6px;
            padding: 8px 14px 0;
            font-size: 18px;
        }

        .refusjon-sum .sum-forventet {
            font-weight: 600;
            color: #4a515e;
        }

        .refusjon-sum .sum-utbetalt {
            font-size: 22px;
            font-weight: 700;
        }

        .dager-igjen {
            margin-top: 12px;
        }

        /* filter-helperen skriver seksjonen én gang per rad med differanse. Vi viser bare den første. */
        .differanse + .differanse {
            display: none;
        }

        .differanse .varsel-ikon {
            width: 18px;
            height: 18px;
            margin-right: 8px;
        }

        .grunner-liste {
            padding-left: 18px;
            margin: 4px 0 0;
        }
    </style>
</head>
<body>
    <h1>Informasjon om refusjon av sykepenger</h1>

    <div class="table width-100 metadata">
        <div class="row">
            <p class="cell">{{iso_to_nor_datetime arbeidstakervedtakFattetTidspunkt}}</p>
            <p class="cell metadata-id">Refusjons-ID: {{refusjonUtfallId}}</p>
        </div>
    </div>

    {{> partials/sykmeldtOgArbeidsgiverInfo
            labelForNavn="Refusjonen gjelder"
            sykmeldtNavn=sykmeldtNavn
            sykmeldtFnr=fnr
            arbeidsgiverNavn=arbeidsgiverNavn
            arbeidsgiverOrgnr=orgnr
    }}

    <p class="intro">
        Dette er en informasjonsmelding som inneholder opplysninger om utbetaling av sykepenger.<br/>
        Dine rettigheter som arbeidsgiver er avledet fra den sykmeldtes rettigheter til sykepenger.
    </p>

    <h2 id="utbetaling">Oversikt over utbetalt refusjon</h2>
    <p class="periode">Periode: {{iso_to_date fom}} – {{iso_to_date tom}}</p>

    <div class="refusjon-header">
        <div class="table width-100 refusjon-tabell">
            <div class="row">
                <p class="cell kol-dagtype">Dagtype</p>
                <p class="cell kol-forespurt">Oppgitt refusjon</p>
                <p class="cell kol-forventet">Forventet</p>
                <p class="cell kol-utbetalt">Utbetalt</p>
                <p class="cell kol-varsel"></p>
            </div>
        </div>
    </div>

    {{#each daggrupper}}
        {{> partials/refusjon/daggruppe }}
    {{/each}}

    <div class="refusjon-sum">
        <div class="table width-100 refusjon-tabell">
            <div class="row">
                <p class="cell kol-dagtype">Sum</p>
                <p class="cell kol-forespurt"></p>
                <p class="cell kol-forventet sum-forventet">{{currency_no beloepForventetRefusjon true}} kr</p>
                <p class="cell kol-utbetalt sum-utbetalt">{{currency_no beloepUtbetaltTilArbeidsgiver true}} kr</p>
                <p class="cell kol-varsel"></p>
            </div>
        </div>
    </div>

    <p class="dager-igjen">Dager igjen med rett til sykepenger: {{dagerIgjenMedRettTilSykepenger}}</p>

    {{#filter daggrupper "sykepengeStatus" "RETT_TIL_SYKEPENGER_DIFFERANSE"}}
        <div class="differanse">
            <h2><img src="{{ image "varsel.svg" }}" class="varsel-ikon" alt=""/>Det er differanse i oppgitt refusjon og utbetalt refusjon</h2>
            <p>
                Refusjonen følger den ansattes rett til sykepenger. Blir refusjonen redusert, kan ikke Nav oppgi
                grunnen til arbeidsgiveren, fordi Nav har taushetsplikt. Den ansatte får begrunnelsen i vedtaket sitt.
            </p>
            <p style="margin-top: 8px;">Vanlige grunner er blant annet:</p>
            <ul class="grunner-liste">
                <li>Inntekten er fastsatt på en annen måte, for eksempel skjønnsfastsatt fordi den avviker mer enn 25 % fra a-ordningen.</li>
                <li>Den ansatte får en annen ytelse fra Nav for de samme dagene.</li>
            </ul>
        </div>
    {{/filter}}
</body>
</html>
