<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html lang="NO">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="description" content="Søknad om fritak fra arbeidsgiverperiode - Gravid" />
    <meta name="subject" content="Søknad om fritak fra arbeidsgiverperiode - Gravid" />
    <meta name="author" content="Nav" />
    <meta name="keywords" content="Nav, søknad" />
    <title>Søknad om fritak fra arbeidsgiverperiode - Gravid</title>
    {{#block 'style' }}
    {{/block}}
</head>
<body>

<h1>Søknad om fritak fra arbeidsgiverperiode - Gravid</h1>

{{> fritakagp/metadata beskrivelse="søknadsID"}}

{{> partials/sykmeldtOgArbeidsgiverInfo
    labelForNavn="Søknaden gjelder"
    sykmeldtNavn=navn
    sykmeldtFnr=identitetsnummer
    arbeidsgiverNavn=virksomhetsnavn
    arbeidsgiverOrgnr=virksomhetsnummer
}}

<h2>Termindato</h2>
<p class="text-thin">{{> partials/valueOrDash v=(iso_to_date termindato) }}</p>

<h2>Arbeidssituasjon og miljø</h2>
<p class="bold mb-2">Har dere prøvd å tilrettelegge arbeidsdagen slik at den gravide kan jobbe til tross for helseplager?</p>
{{#if tilrettelegge}}
<p class="text-thin mb-3">Ja</p>
<p class="bold mb-2">Hvilke tiltak har dere forsøkt eller vurdert for at den ansatte kan jobbe:</p>
{{#each tiltak}}
<p class="text-thin bullet-list">&#8226; {{#eq this "TILPASSET_ARBEIDSTID"}}Fleksibel eller tilpasset arbeidstid{{/eq}}{{#eq this "HJEMMEKONTOR"}}Hjemmekontor{{/eq}}{{#eq this "TILPASSEDE_ARBEIDSOPPGAVER"}}Tilpassede arbeidsoppgaver{{/eq}}{{#eq this "ANNET"}}Annet, gi en kort beskrivelse av hva dere har gjort:{{/eq}}</p>
{{/each}}
{{#if tiltakBeskrivelse}}
<p class="text-thin mb-3">{{tiltakBeskrivelse}}</p>
{{/if}}
{{else}}
<p class="text-thin mb-3">Nei</p>
{{/if}}

<p class="bold mb-2">Har dere forsøkt omplassering til annen jobb?</p>
{{#if omplassering}}
<p class="text-thin">{{#eq omplassering "JA"}}Ja{{/eq}}{{#eq omplassering "NEI"}}Nei{{/eq}}{{#eq omplassering "IKKE_MULIG"}}Omplassering er ikke mulig{{/eq}}{{#if omplasseringAarsak}} - {{#eq omplasseringAarsak "MOTSETTER"}}Den ansatte motsetter seg omplassering{{/eq}}{{#eq omplasseringAarsak "FAAR_IKKE_KONTAKT"}}Vi får ikke kontakt med den ansatte{{/eq}}{{#eq omplasseringAarsak "IKKE_ANDRE_OPPGAVER"}}Vi har ikke andre oppgaver eller arbeidssteder å tilby{{/eq}}{{#eq omplasseringAarsak "HELSETILSTANDEN"}}Den ansatte vil ikke fungere i en annen jobb på grunn av helsetilstanden{{/eq}}{{/if}}</p>
{{else}}
<p class="text-thin">—</p>
{{/if}}

<h2>Vedlegg til søknad</h2>
{{#if harVedlegg}}
<p class="text-thin">Dokumentasjon vedlagt</p>
{{else}}
<p class="text-thin grey-text">Dokumentasjon ikke vedlagt</p>
{{/if}}

<h2>Innrapporert av</h2>
<p>{{> partials/valueOrDash v=sendtAvNavn}}</p>

</body>
</html>
