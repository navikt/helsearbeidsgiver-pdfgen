<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html lang="NO">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="description" content="Krav om refusjon for arbeidsgiverperiode - Gravid" />
    <meta name="subject" content="Krav om refusjon for arbeidsgiverperiode - Gravid" />
    <meta name="author" content="Nav" />
    <meta name="keywords" content="Krav om refusjon for arbeidsgiverperiode - Gravid" />
    <title>Krav om refusjon for arbeidsgiverperiode - Gravid</title>
    {{#block 'style' }}
    {{/block}}
</head>
<body>

<h1>Krav om refusjon for arbeidsgiverperiode - Gravid</h1>

<div class="table width-100">
    <div class="row">
        <p style="text-align: left;" class="cell grey-text text-sm">
            Sendt {{ iso_to_nor_datetime opprettet}}
        </p>
        {{#if referansenummer}}
        <p style="text-align: right;" class="cell grey-text text-sm">
            ID: {{referansenummer}}
        </p>
        {{/if}}
    </div>
</div>

{{> partials/sykmeldtOgArbeidsgiverInfo
    labelForNavn="Kravet gjelder"
    sykmeldtNavn=navn
    sykmeldtFnr=identitetsnummer
    arbeidsgiverNavn=virksomhetsnavn
    arbeidsgiverOrgnr=virksomhetsnummer
}}

<h2>Fraværsperioder</h2>

{{#each perioder}}
<div class="period-row mb-3">
    <div class="table width-100">
        <div class="row">
            <p class="cell font-semibold" style="text-align: left;">
                {{> partials/periodeMedAntallDager fom=fom tom=tom }}
            </p>
            <p class="cell" style="text-align: right;">
                Antall dager fravær i perioden: {{antallDagerMedRefusjon}}
            </p>
        </div>
    </div>
    <div style="height: 12px; line-height: 12px;">&#160;</div>
    <div class="table width-100 grey-text text-thin" style="font-size: 13px;">
        <div class="row">
            <p class="cell" style="width: 25%;">Sykmeldingsgrad: {{graderingProsent}} %</p>
            <p class="cell" style="width: 30%;">Beregnet månedsinntekt: {{maanedsinntekt}}</p>
            <p class="cell" style="width: 20%;">Dagsats: {{dagsats}} kr</p>
            <p class="cell" style="width: 25%;">Beløp periode: {{belop}} kr</p>
        </div>
    </div>
</div>
{{/each}}

<h2>Innrapporert av</h2>
<p>{{> partials/valueOrDash v=sendtAvNavn}}</p>

</body>
</html>
