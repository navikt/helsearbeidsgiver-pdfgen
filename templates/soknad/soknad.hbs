<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html lang="NO">
<head>
    {{!--      TODO: Bytt til Søknad --}}
    {{!--     <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" /> --}}
    {{!--     <meta name="description" content="Sykmelding" /> --}}
    {{!--     <meta name="subject" content="Sykmelding" /> --}}
    {{!--     <meta name="author" content="Nav" /> --}}
    {{!--     <meta name="keywords" content="sykmelding" /> --}}
    <title>Sykmelding</title>
    {{#block 'style' }}
    {{/block}}
</head>
<body>

<h1>Søknad om sykepenger</h1>

{{!-- bruker display: table da dette anbefales av openHTMLtoPDF for accesibility --}}
{{!-- Avoid using table elements for layout. Instead, if desiring a table based layout, use a div with display: table, display: table-row, etc. --}}
<div style="margin-top: 0px; display: table; width: 100%;">
    <div style="display: table-row;">
        <div style="display: table-cell; text-align: left;" class="metadata-text text-sm">
            <br/>Mottatt av Nav {{ iso_to_nor_datetime mottatTid}}
        </div>
        <div style="display: table-cell; text-align: right;" class="metadata-text text-sm">
            Søknads-ID: {{soeknadId}}<br/>
            Sykmeldings-ID: {{sykmeldingId}}
        </div>
    </div>
</div>
{{> partials/sykmeldtOgArbeidsgiverInfo
        sykmeldtNavn="TODO: NAVN"
        sykmeldtFnr=fnr
        arbeidsgiverNavn=arbeidsgiver.navn
        arbeidsgiverOrgnr=arbeidsgiver.orgnr
}}
<div>
    <h2>Søknadsperioder</h2>
    {{!--     <div class="text-thin mb-3 text-sm">Sykefravær fra: --}}
    {{!--         {{#if sykefravaerFom}} --}}
    {{!--             {{ iso_to_date sykefravaerFom }} --}}
    {{!--         {{else}} --}}
    {{!--             ——— --}}
    {{!--         {{/if}} --}}
    {{!--     </div> --}}

    <!--    <div class="table width-100 header-row text-sm">-->
    <!--        <div class="row">-->
    <!--            <p class="cell period-type text-thin text-xs">Kategori</p>-->
    <!--            <p class="cell period-dates text-thin text-xs">Periode</p>-->
    <!--            <p class="cell text-thin text-xs">Sykmeldingsgrad</p>-->
    <!--            <p class="cell text-thin text-xs">Arbeidsuke</p>-->
    <!--            <p class="cell text-thin text-xs">Arbeidet / arbeidsgrad</p>-->
    <!--        </div>-->
    <!--    </div>-->

    <div class="table width-100" style="margin-bottom: -7px;">
        <div class="row grey-text text-thin text-xs">
            <p class="cell" style="padding: 0px 15px; width: 24%;">Beskrivelse</p>
            <p class="cell" style="width: 39%;">Periode</p>
            <p class="cell text-thin" style="width: 13%;">Arbeidsuke</p>
            <p class="cell text-thin">Faktisk Arbeidet/Arbeidsgrad</p>
        </div>
    </div>
    <div class="table width-100" style="border-spacing: 0 13px;">
        {{#each soeknadsperioder}}
            <div class="row period-row">
                <p class="cell font-semibold" style="padding: 6px 18px; border-radius: 12px 0 0 12px; width: 24%;">
                    {{#eq sykmeldingstype "AKTIVITET_IKKE_MULIG"}}100% Sykmeldt{{/eq}}
                    {{#eq sykmeldingstype "GRADERT"}}{{sykmeldingsgrad}}% Sykmeldt{{/eq}}
                    {{#eq sykmeldingstype "BEHANDLINGSDAGER"}}Behandlingsdager{{/eq}}
                    {{#eq sykmeldingstype "AVVENTENDE_SYKMELDING"}}Avventende sykmelding{{/eq}}
                    {{#eq sykmeldingstype "REISETILSKUDD"}}Reisetilskudd{{/eq}}
                </p>
                <p class="cell text-thin" style="width: 39%;">
                    {{> partials/periodeMedAntallDager fom=fom tom=tom }}
                </p>
                <!--                <p class="cell text-thin" style="width: 13.5%;">-->
                <!--                    {{> partials/valueOrDash v=sykmeldingsgrad }}{{#if sykmeldingsgrad}}%{{/if}}-->
                <!--                </p>-->
                <p class="cell text-thin" style="width: 13%;">
                    {{> partials/valueOrDash v=avtaltTimer }}{{#if avtaltTimer}} t{{/if}}
                </p>
                <p class="cell text-thin" style="border-radius: 0 12px 12px 0;">
                    {{#if faktiskTimer}}
                        {{faktiskTimer}} t{{#if faktiskGrad}} / {{faktiskGrad}}%{{/if}}
                    {{else}}
                        {{> partials/valueOrDash v=faktiskGrad }}{{#if faktiskGrad}}%{{/if}}
                    {{/if}}
                </p>
            </div>
        {{/each}}
    </div>

</div>

<h2 class="mb-3">Fraværsperioder</h2>
{{#if fravaer}}
    {{#each fravaer}}
    <div class="table width-100 period-row">
        <div class="row">
            <p class="cell font-semibold" style="width: 30%;">
                {{#eq type "FERIE"}}Ferie{{/eq}}
                {{#eq type "PERMISJON"}}Permisjon{{/eq}}
                {{#eq type "UTENLANDSOPPHOLD"}}Utenlandsopphold{{/eq}}
            </p>
            <p class="cell text-thin" style="text-align: right;">
                {{> partials/periodeMedAntallDager fom=fom tom=tom }}
            </p>
        </div>
    </div>
    {{/each}}
{{else}}
    <p class="text-thin mb-3">Ingen fraværsperioder oppgitt.</p>
{{/if}}

<h2>Oppfølging</h2>

{{!-- Skal vises bare om ingen av de andre oppfølgings punktene ble vist--}}
{{!-- {{#any oppfoelging.prognose oppfoelging.tiltakArbeidsplassen oppfoelging.meldingTilArbeidsgiver}} {{else}} --}}
{{!--     {{#contains_field sykmeldingPerioder "aktivitet.aktivitetIkkeMulig.beskrivelse"}} {{else}} --}}
{{!--         {{#contains_field sykmeldingPerioder "aktivitet.avventendeSykmelding"}} {{else}} --}}
{{!--             <div class="text-thin section-subtitle">Ingen oppfølging oppgitt.</div> --}}
{{!--         {{/contains_field}} --}}
{{!--     {{/contains_field}} --}}
{{!-- {{/any}} --}}


<table>
    {{#if oppfoelging.prognose}}
        <tr>
            <td class="followup-item">
                <div class="text-bold">Har det blitt søkt om utenlandsopphold? </div>
                {{!--             {{#if oppfoelging.prognose.erArbeidsfoerEtterEndtPeriode}} --}}
                {{!--             <div style="margin: 4px 0;">&#8226; Arbeidsfør etter endt periode</div> --}}
                {{!--             {{/if}} --}}
                {{!--             {{#if oppfoelging.prognose.beskrivHensynArbeidsplassen}} --}}
                <div class="text-thin">TODO: Implementer</div>
                {{!--             {{/if}} --}}
            </td>
        </tr>
    {{/if}}
    {{!--     {{#if oppfoelging.tiltakArbeidsplassen}} --}}
    {{!--     <tr> --}}
    {{!--         <td class="followup-item"> --}}
    {{!--             <div class="text-bold">Tiltak som kan bedre ansattes arbeidsevne</div> --}}
    {{!--             <div class="text-thin">{{oppfoelging.tiltakArbeidsplassen}}</div> --}}
    {{!--         </td> --}}
    {{!--     </tr> --}}
    {{!--     {{/if}} --}}
    {{!--     {{#if oppfoelging.meldingTilArbeidsgiver}} --}}
    {{!--     <tr> --}}
    {{!--         <td class="followup-item"> --}}
    {{!--             <div class="text-bold">Melding fra behandler til arbeidsgiver</div> --}}
    {{!--             <div class="text-thin">{{oppfoelging.meldingTilArbeidsgiver}}</div> --}}
    {{!--         </td> --}}
    {{!--     </tr> --}}
    {{!--     {{/if}} --}}
    {{!--      --}}{{!-- forventer at det alltid er bare en aktivitetIkkeMulig.beskrivelse, om ikke aksepterer vi rar formattering  --}}
    {{!--     {{#each sykmeldingPerioder}} --}}
    {{!--         {{#if aktivitet.aktivitetIkkeMulig.beskrivelse}} --}}
    {{!--                 <tr> --}}
    {{!--                     <td class="followup-item"> --}}
    {{!--                         <div class="text-bold">Forhold på arbeidsplassen vanskeliggjør arbeidsrelatert aktivitet</div> --}}
    {{!--                         <div class="text-thin">{{aktivitet.aktivitetIkkeMulig.beskrivelse}}</div> --}}
    {{!--                     </td> --}}
    {{!--                 </tr> --}}
    {{!--             {{/if}} --}}
    {{!--     {{/each}} --}}

    {{!--      --}}{{!-- forventer at det alltid er bare en aktivitet.avventendeSykmelding, om ikke aksepterer vi rar formattering  --}}
    {{!--         {{#each sykmeldingPerioder}} --}}
    {{!--             {{#if aktivitet.avventendeSykmelding}} --}}
    {{!--                     <tr> --}}
    {{!--                         <td class="followup-item"> --}}
    {{!--                             <div class="text-bold">Innspill til arbeidsgiver om tilrettelegging</div> --}}
    {{!--                             <div class="text-thin">{{aktivitet.avventendeSykmelding}}</div> --}}
    {{!--                         </td> --}}
    {{!--                     </tr> --}}
    {{!--                 {{/if}} --}}
    {{!--         {{/each}} --}}
</table>

